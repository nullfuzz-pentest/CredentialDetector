<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>creddetector</groupId>
    <artifactId>credential-detector</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Credential Detector</name>
    <description>Burp Suite extension that detects credentials/secrets in HTTP responses.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Burp Montoya API: only needed to compile; Burp provides it at runtime. -->
        <dependency>
            <groupId>net.portswigger.burp.extensions</groupId>
            <artifactId>montoya-api</artifactId>
            <version>2026.7</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The sources use a flat layout (src/creddetector) instead of the
             Maven default (src/main/java), so point the compiler at it. -->
        <sourceDirectory>src</sourceDirectory>
        <finalName>CredentialDetector</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Burp-Extension-Class>creddetector.CredentialDetectorExtension</Burp-Extension-Class>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
